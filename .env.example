# Copy to .env.local. Never commit real keys.

# ── Next.js app ──
# `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# The deployment's HTTP actions URL (…convex.site), where sign-in is served.
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Set these on the Convex deployment: npx convex env set NAME value ──
#   SITE_URL              http://localhost:3000
#   BETTER_AUTH_SECRET    32+ random characters
#   GOOGLE_CLIENT_ID      sign-in is Google only (for now)
#   GOOGLE_CLIENT_SECRET
#   OPENAI_API_KEY        the agents' brains (Responses API)
#   ORGO_API_KEY          the board computer (orgo.ai); also set it here for the screen routes
#   COMPOSIO_API_KEY      the apps agents can use (composio.dev)
#   TYPESAFE_API_KEY      optional: Jev, the judge that picks which agent answers

# ── For the board computer's screen (Next.js API routes) ──
ORGO_API_KEY=
